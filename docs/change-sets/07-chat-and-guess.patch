+        <button
+          type="submit"
+          disabled={!inputText.trim()}
+          style={{
+            display: 'flex',
+            alignItems: 'center',
+            justifyContent: 'center',
+            padding: '0.55rem 0.95rem',
+            borderRadius: '10px',
+            backgroundColor: inputText.trim() ? '#0284c7' : '#94a3b8',
+            color: '#ffffff',
+            border: 'none',
+            cursor: inputText.trim() ? 'pointer' : 'not-allowed',
+            transition: 'background-color 0.15s',
+          }}
+        >
+          <Send size={16} />
+        </button>
+      </form>
+    </div>
+  );
+};
