+        onSubmit={handleSubmit}
+        style={{
+          display: 'flex',
+          gap: '0.5rem',
+          padding: '0.65rem 0.75rem',
+          backgroundColor: '#ffffff',
+          borderTop: '2px solid #e2e8f0',
+        }}
