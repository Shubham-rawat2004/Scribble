+              fontStyle: 'italic',
+            }}
+          >
+            Match chat started! Guesses will appear here.
+          </div>
+        ) : (
+          messages.map((msg) => {
+            if (msg.type === 'SUCCESS') {
+              return (
+                <div
+                  key={msg.id}
+                  style={{
+                    backgroundColor: '#d1fae5',
+                    color: '#065f46',
+                    fontWeight: 700,
+                    padding: '0.4rem 0.75rem',
+                    borderRadius: '8px',
+                    fontSize: '0.85rem',
+                    borderLeft: '4px solid #10b981',
+                    display: 'flex',
+                    alignItems: 'center',
+                    gap: '0.4rem',
+                  }}
+                >
+                  <Sparkles size={15} color="#059669" />
+                  <span>{msg.text}</span>
+                </div>
+              );
+            }
+
+            if (msg.type === 'SELF_SUCCESS') {
+              return (
+                <div
+                  key={msg.id}
+                  style={{
+                    backgroundColor: '#10b981',
+                    color: '#ffffff',
+                    fontWeight: 800,
+                    padding: '0.5rem 0.75rem',
+                    borderRadius: '8px',
+                    fontSize: '0.9rem',
