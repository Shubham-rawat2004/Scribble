+                    color: '#064e3b',
+                    padding: '0.35rem 0.65rem',
+                    borderRadius: '8px',
+                    fontSize: '0.875rem',
+                    wordBreak: 'break-word',
+                    border: '1px solid #a7f3d0',
+                  }}
+                >
+                  <span
+                    style={{
+                      fontSize: '0.72rem',
+                      backgroundColor: '#10b981',
+                      color: '#ffffff',
+                      padding: '0.1rem 0.35rem',
+                      borderRadius: '4px',
+                      fontWeight: 700,
+                      marginRight: '0.4rem',
+                    }}
+                  >
+                    SOLVER
+                  </span>
+                  <span style={{ fontWeight: 800, color: '#047857' }}>{msg.senderName}: </span>
+                  <span>{msg.text}</span>
+                </div>
+              );
+            }
+
+            // Normal CHAT or SYSTEM
+            return (
+              <div
+                key={msg.id}
+                style={{
+                  backgroundColor: '#ffffff',
+                  color: '#1e293b',
+                  padding: '0.35rem 0.65rem',
+                  borderRadius: '8px',
+                  fontSize: '0.875rem',
+                  wordBreak: 'break-word',
+                  boxShadow: '0 1px 2px rgba(0, 0, 0, 0.05)',
+                  border: '1px solid #e2e8f0',
+                }}
+              >
+                <span style={{ fontWeight: 800, color: '#2563eb' }}>{msg.senderName}: </span>
+                <span>{msg.text}</span>
+              </div>
+            );
+          })
+        )}
+        <div ref={messagesEndRef} />
+      </div>
+
+      {/* Input Field */}
