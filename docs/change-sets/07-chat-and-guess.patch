+import React, { useState, useRef, useEffect } from 'react';
+import { Send, MessageSquare, CheckCircle2, Sparkles, AlertTriangle } from 'lucide-react';
+import { ChatMessage } from '../types/game';
+
+interface ChatBoxProps {
+  messages: ChatMessage[];
+  onSendMessage: (text: string) => void;
+  isDrawer: boolean;
+  hasGuessed: boolean;
+  isDrawingPhase: boolean;
+}
+
+export const ChatBox: React.FC<ChatBoxProps> = ({
+  messages,
+  onSendMessage,
+  isDrawer,
+  hasGuessed,
+  isDrawingPhase,
+}) => {
+  const [inputText, setInputText] = useState('');
+  const messagesEndRef = useRef<HTMLDivElement>(null);
+
+  // Auto-scroll to latest message
+  useEffect(() => {
+    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
+  }, [messages]);
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmed = inputText.trim();
+    if (!trimmed) return;
+    onSendMessage(trimmed);
+    setInputText('');
+  };
+
+  // Determine placeholder context
+  let placeholder = 'Type your guess here...';
+  if (isDrawer && isDrawingPhase) {
+    placeholder = 'You are drawing! Chat with players...';
+  } else if (hasGuessed && isDrawingPhase) {
+    placeholder = 'Chat with other guessers...';
+  }
+
+  return (
+    <div
+      style={{
+        display: 'flex',
+        flexDirection: 'column',
+        width: '100%',
+        height: '100%',
+        minHeight: '440px',
+        backgroundColor: '#ffffff',
+        borderRadius: '16px',
+        border: '3px solid #1e293b',
+        boxShadow: '0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)',
+        overflow: 'hidden',
+      }}
+    >
+      {/* Header */}
+      <div
+        style={{
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'space-between',
+          padding: '0.65rem 1rem',
+          backgroundColor: '#0284c7',
+          color: '#ffffff',
+          fontWeight: 800,
+          fontSize: '0.95rem',
+          letterSpacing: '0.025em',
+          borderBottom: '2px solid #0369a1',
+        }}
+      >
+        <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
+          <MessageSquare size={18} />
+          <span>Game Chat</span>
+        </div>
+        {hasGuessed && isDrawingPhase && (
+          <span
+            style={{
+              fontSize: '0.75rem',
+              backgroundColor: '#10b981',
+              padding: '0.15rem 0.5rem',
+              borderRadius: '999px',
+              display: 'flex',
+              alignItems: 'center',
+              gap: '0.25rem',
+            }}
+          >
+            <CheckCircle2 size={13} /> Guessed
+          </span>
+        )}
+      </div>
+
+      {/* Message Stream */}
+      <div
+        style={{
+          flex: 1,
+          overflowY: 'auto',
+          padding: '0.75rem',
+          display: 'flex',
+          flexDirection: 'column',
+          gap: '0.45rem',
+          backgroundColor: '#f8fafc',
+          maxHeight: '420px',
+        }}
+      >
+        {messages.length === 0 ? (
+          <div
+            style={{
+              textAlign: 'center',
+              color: '#94a3b8',
+              fontSize: '0.85rem',
