+                  key={msg.id}
+                  style={{
+                    backgroundColor: '#fef3c7',
+                    color: '#92400e',
+                    fontWeight: 700,
+                    padding: '0.4rem 0.75rem',
+                    borderRadius: '8px',
+                    fontSize: '0.85rem',
+                    borderLeft: '4px solid #f59e0b',
+                    display: 'flex',
+                    alignItems: 'center',
