+          type="text"
+          value={inputText}
+          onChange={(e) => setInputText(e.target.value)}
+          placeholder={placeholder}
+          maxLength={120}
+          style={{
+            flex: 1,
+            padding: '0.55rem 0.85rem',
+            borderRadius: '10px',
+            border: '2px solid #cbd5e1',
+            fontSize: '0.875rem',
+            outline: 'none',
+            fontWeight: 600,
+            color: '#1e293b',
+          }}
