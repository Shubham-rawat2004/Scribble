+++ b/backend/src/game/WordManager.ts
@@ -0,0 +1,76 @@
+import { pool } from '../db/connection.js';
+
+export interface WordOption {
+  word: string;
+  category: string;
+  difficulty: string;
+}
+
+const FALLBACK_WORDS: WordOption[] = [
+  // Animals
+  { word: 'cat', category: 'ANIMALS', difficulty: 'EASY' },
+  { word: 'dog', category: 'ANIMALS', difficulty: 'EASY' },
+  { word: 'elephant', category: 'ANIMALS', difficulty: 'MEDIUM' },
+  { word: 'giraffe', category: 'ANIMALS', difficulty: 'MEDIUM' },
+  { word: 'penguin', category: 'ANIMALS', difficulty: 'EASY' },
+  { word: 'lion', category: 'ANIMALS', difficulty: 'EASY' },
+  { word: 'dolphin', category: 'ANIMALS', difficulty: 'MEDIUM' },
+  { word: 'monkey', category: 'ANIMALS', difficulty: 'EASY' },
+  { word: 'kangaroo', category: 'ANIMALS', difficulty: 'HARD' },
+  // Food
+  { word: 'pizza', category: 'FOOD', difficulty: 'EASY' },
+  { word: 'burger', category: 'FOOD', difficulty: 'EASY' },
+  { word: 'ice cream', category: 'FOOD', difficulty: 'EASY' },
+  { word: 'banana', category: 'FOOD', difficulty: 'EASY' },
+  { word: 'pancake', category: 'FOOD', difficulty: 'MEDIUM' },
+  { word: 'chocolate', category: 'FOOD', difficulty: 'MEDIUM' },
+  // Objects
+  { word: 'guitar', category: 'OBJECTS', difficulty: 'EASY' },
+  { word: 'airplane', category: 'OBJECTS', difficulty: 'EASY' },
+  { word: 'rocket', category: 'OBJECTS', difficulty: 'MEDIUM' },
+  { word: 'computer', category: 'OBJECTS', difficulty: 'EASY' },
+  { word: 'bicycle', category: 'OBJECTS', difficulty: 'EASY' },
+  { word: 'clock', category: 'OBJECTS', difficulty: 'EASY' },
+  { word: 'umbrella', category: 'OBJECTS', difficulty: 'MEDIUM' },
+  { word: 'telescope', category: 'OBJECTS', difficulty: 'HARD' },
+  // Places
+  { word: 'castle', category: 'PLACES', difficulty: 'MEDIUM' },
+  { word: 'pyramid', category: 'PLACES', difficulty: 'MEDIUM' },
+  { word: 'beach', category: 'PLACES', difficulty: 'EASY' },
+  { word: 'hospital', category: 'PLACES', difficulty: 'MEDIUM' },
+  { word: 'island', category: 'PLACES', difficulty: 'EASY' },
+  // Actions
+  { word: 'swimming', category: 'ACTIONS', difficulty: 'MEDIUM' },
+  { word: 'dancing', category: 'ACTIONS', difficulty: 'MEDIUM' },
+  { word: 'sleeping', category: 'ACTIONS', difficulty: 'EASY' },
+  { word: 'flying', category: 'ACTIONS', difficulty: 'MEDIUM' },
+  { word: 'cooking', category: 'ACTIONS', difficulty: 'EASY' },
+];
+
+export class WordManager {
+  /**
+   * Fetches N random word options for the drawer.
+   * Attempts to query MySQL `words` table first; seamlessly falls back to categorized memory catalog.
+   */
+  public static async getRandomWords(count: number = 3): Promise<WordOption[]> {
+    const safeCount = Math.min(Math.max(count, 1), 5);
+
+    try {
+      const [rows] = await pool.query(
+        `SELECT word, category, difficulty FROM words ORDER BY RAND() LIMIT ?`,
+        [safeCount]
+      );
+
+      const dbWords = rows as WordOption[];
+      if (dbWords && dbWords.length >= safeCount) {
+        return dbWords;
+      }
+    } catch (err) {
+      console.warn('[WordManager] DB query fallback to memory catalog:', (err as Error).message);
+    }
+
+    // Fallback: shuffle memory catalog
+    const shuffled = [...FALLBACK_WORDS].sort(() => 0.5 - Math.random());
+    return shuffled.slice(0, safeCount);
+  }
+}
diff --git a/backend/src/sockets/gameHandler.ts b/backend/src/sockets/gameHandler.ts
new file mode 100644
index 0000000..786e933
--- /dev/null
+++ b/backend/src/sockets/gameHandler.ts
@@ -0,0 +1,155 @@
+import { Server as SocketIOServer, Socket } from 'socket.io';
+import { RoomManager } from '../game/RoomManager.js';
+
+/**
+ * Registers turn management, word selection, and progressive hint socket event listeners.
+ */
+export function registerGameHandlers(io: SocketIOServer, socket: Socket) {
+  const roomManager = RoomManager.getInstance();
+
+  /**
+   * Helper function: triggers word selection phase for the active drawer.
+   */
+  async function triggerWordSelection(roomId: string) {
+    const room = roomManager.getRoom(roomId);
+    const turnManager = roomManager.getTurnManager(roomId);
+    if (!room || !turnManager) return;
+
+    const nextTurn = await turnManager.prepareNextTurn();
+
+    if (nextTurn.isMatchFinished) {
+      console.log(`[Game] Room ${roomId} match completed all rounds!`);
+      io.to(room.id).emit('match_finished', {
+        roomId: room.id,
+        scores: room.getPlayerList().map((p) => p.toDTO()),
+      });
+      return;
+    }
+
+    const drawer = room.getPlayer(nextTurn.drawerId || '');
+    if (!drawer) return;
+
+    // 1. Send word choices to the designated Drawer only
+    io.to(drawer.socketId).emit('word_selection_start', {
+      roomId: room.id,
+      words: nextTurn.wordOptions,
+      durationSeconds: 15,
+    });
+
+    // 2. Broadcast waiting banner to all Guessers
+    socket.to(room.id).emit('drawer_choosing_word', {
+      roomId: room.id,
+      drawerId: drawer.id,
+      drawerName: drawer.name,
+      durationSeconds: 15,
+    });
+
+    console.log(`[Game] Room ${roomId}: Drawer ${drawer.name} is choosing from ${nextTurn.wordOptions.length} words.`);
+  }
+
+  /**
+   * Event: start_game listener extension to immediately begin Turn 1 word selection.
+   */
+  socket.on('start_game', async (payload: { roomId: string }) => {
+    // Note: roomHandler already validates host and changes status to PLAYING.
+    // We add a tiny delay to allow client views to transition to GameView.
+    setTimeout(() => {
+      triggerWordSelection(payload.roomId);
+    }, 600);
+  });
+
+  /**
+   * Event: select_word
+   * Emitted by the active drawer when choosing a word.
+   */
+  socket.on('select_word', async (payload: { roomId: string; word: string }, callback?: (res: { success: boolean }) => void) => {
+    try {
+      const { roomId, word } = payload;
+      const room = roomManager.getRoom(roomId);
+      const turnManager = roomManager.getTurnManager(roomId);
+
+      if (!room || !turnManager) {
+        if (callback) callback({ success: false });
+        return;
+      }
+
+      // Security Check: Only the active drawer can pick the word
+      if (!room.isDrawer(socket.id)) {
+        console.warn(`[Security] Unauthorized select_word attempt from ${socket.id}`);
+        if (callback) callback({ success: false });
+        return;
+      }
+
+      console.log(`[Game] Room ${roomId}: Drawer selected word "${word}"`);
+
+      // Clear previous canvas strokes for the new turn
+      room.clearCanvas();
+      io.to(room.id).emit('canvas_clear', { roomId: room.id });
+
+      const drawer = room.getPlayer(turnManager.currentDrawerId || '');
+
+      // Start Drawing Turn with Progressive Hints and Countdown Timer
+      const { secretWord, initialMask } = await turnManager.startDrawingTurn(
+        word,
+        // On Hint Reveal Callback
+        (newMask) => {
+          console.log(`[Hint] Room ${roomId}: Hint revealed! Current mask: "${newMask}"`);
+          io.to(room.id).emit('word_hint', {
+            roomId: room.id,
+            wordMask: newMask,
+          });
+        },
+        // On Time Tick Callback
+        (secondsLeft) => {
+          io.to(room.id).emit('turn_timer_tick', {
+            roomId: room.id,
+            timeRemainingSeconds: secondsLeft,
+          });
+        },
+        // On Turn End Callback
+        () => {
+          console.log(`[Game] Room ${roomId}: Turn ended (Time expired)`);
+          io.to(room.id).emit('turn_end', {
+            roomId: room.id,
+            secretWord,
+            reason: 'TIME_UP',
+          });
+
+          // Wait 3.5 seconds to show turn results, then advance to next drawer
+          setTimeout(() => {
+            triggerWordSelection(roomId);
+          }, 3500);
+        }
+      );
+
+      // Emitted to the Drawer: Full plaintext word
+      if (drawer) {
+        io.to(drawer.socketId).emit('turn_start', {
+          role: 'DRAWER',
+          secretWord,
+          drawTimeSeconds: room.settings.drawTimeSeconds,
+          currentRound: turnManager.currentRound,
+          totalRounds: room.settings.totalRounds,
+          currentTurn: turnManager.currentTurn,
+          totalTurnsInRound: room.players.size,
+        });
+      }
+
+      // Emitted to all Guessers: ZERO-TRUST MASK ONLY!
+      socket.to(room.id).emit('turn_start', {
+        role: 'GUESSER',
+        wordMask: initialMask,
+        wordLength: secretWord.length,
+        drawTimeSeconds: room.settings.drawTimeSeconds,
+        currentRound: turnManager.currentRound,
+        totalRounds: room.settings.totalRounds,
+        currentTurn: turnManager.currentTurn,
+        totalTurnsInRound: room.players.size,
+      });
+
+      if (callback) callback({ success: true });
+    } catch (err) {
+      console.error('[Socket.IO] Error in select_word:', (err as Error).message);
+    }
+  });
+}
